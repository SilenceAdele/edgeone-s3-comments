# Copy to .env for local `npm run dev`, and fill the same names in
# EdgeOne Pages console -> Project -> Settings -> Environment Variables.
# Never commit real values.

# ---- S3 (required) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Hostname only, no scheme. Example: <account>.s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=cn-north-1
# The app name the AccessKey is bound to; the gateway rejects other User-Agents.
UA_PREFIX=S3Drive

# ---- Comments ----
# Root key prefix. Scope the AccessKey to this prefix.
COMMENT_PREFIX=comments/v1
# Signs IP hashes. Any long random string; changing it resets rate limits.
IP_SALT=
# Comma separated allowed origins, e.g. https://blog.example.com
COMMENT_ORIGINS=
# Admin delete token. Leave empty to disable the DELETE endpoint.
COMMENT_TOKEN=
COMMENT_PAGE_SIZE=20
COMMENT_RATE_MAX=5

# ---- Email notifications (optional) ----
# `resend` enables them; empty/off disables.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
# Where owner notifications go. Masked on /api/health.
MAIL_TO=
MAIL_REPLY_TO=
# Signs unsubscribe links. Independent from IP_SALT.
MAIL_SALT=
# Public origin of this function, used in unsubscribe links.
COMMENT_API_URL=
# Blog origin and name used in emails.
SITE_URL=
SITE_NAME=
